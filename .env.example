# ===== Texte : FreeLLMAPI (routeur de LLM gratuits, installé sur le même VPS) =====
# Laisser LLM_BASE_URL vide pour n'utiliser que Cloudflare.
LLM_BASE_URL=http://127.0.0.1:3001/v1
LLM_API_KEY=freellmapi-...                     # clé unifiée, en haut de la page Keys du tableau de bord
LLM_MODEL=auto:smart                           # écriture du script (ou auto:<ton-profil>)
LLM_FACTCHECK_MODEL=fusion                     # vérification multi-modèles ; vide = même modèle que l'écriture
IMAGE_FALLBACK_MODEL=auto                      # images de secours si le quota Cloudflare est épuisé

# ===== Cloudflare Workers AI (images principales + secours texte) =====
# Offre gratuite : 10 000 "neurons"/jour, sans carte bancaire
CF_ACCOUNT_ID=...
CF_API_TOKEN=...
CF_TEXT_MODEL=@cf/openai/gpt-oss-120b
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b   # ou @cf/black-forest-labs/flux-1-schnell

# ===== Voix Kokoro (locale) =====
# am_michael, am_fenrir, am_puck (US) / bm_george, bm_fable (UK)
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.05

TARGET_SECONDS=120
MUSIC_VOLUME=0.10                              # mp3 libres de droits dans assets/music/, 0 pour couper

# ===== Publication (API gratuites) =====
PUBLISH_YOUTUBE=true
PUBLISH_INSTAGRAM=true
PUBLISH_TIKTOK=true

YOUTUBE_CLIENT_SECRETS=state/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=state/youtube_token.json
YOUTUBE_PRIVACY=private                        # passe à public après quelques jours de relecture

IG_USER_ID=...
IG_ACCESS_TOKEN=...
IG_GRAPH_VERSION=v23.0
PUBLIC_VIDEO_DIR=/var/www/aymendridi.com/shorts
PUBLIC_VIDEO_BASE_URL=https://aymendridi.com/shorts

TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_TOKEN_FILE=state/tiktok_token.json
