# ===== Docker / Traefik =====
SHORTS_DOMAIN=aymendridi.com                   # domaine déjà géré par Traefik ; vidéos servies sur https://<domaine>/shorts/
ADMIN_DOMAIN=daily.creationapp.academy         # interface d'administration
LLM_DOMAIN=llm.daily.creationapp.academy       # tableau de bord FreeLLMAPI (accessible une fois connecté à l'admin)
CHANNEL_NAME=Anime Storytelling
CONTACT_EMAIL=                                 # adresse de contact affichée sur les pages publiques /terms et /privacy
FREELLMAPI_PORT=3001                           # port local (127.0.0.1) du tableau de bord FreeLLMAPI
# Les valeurs ci-dessous (heures, durées, plateformes, voix) sont des valeurs de départ :
# une fois modifiées dans l'interface d'administration, ce sont celles de l'admin qui comptent.
GENERATE_AT=01:00                              # création des vidéos du jour (heure de Paris) ; vide = tout à PUBLISH_AT
PUBLISH_AT=16:47                               # publication des vidéos du jour (heure de Paris)

# ===== Texte : FreeLLMAPI (conteneur "freellmapi" ; LLM_BASE_URL est fixé par docker-compose) =====
LLM_API_KEY=freellmapi-...                     # clé unifiée, en haut de la page Keys du tableau de bord
LLM_MODEL=auto:smart                           # écriture du script (ou auto:<ton-profil>)
LLM_FACTCHECK_MODEL=fusion                     # vérification multi-modèles ; vide = même modèle que l'écriture
IMAGE_FALLBACK_MODEL=auto                      # images de secours si le quota Cloudflare est épuisé

# ===== Cloudflare Workers AI (images principales + secours texte) =====
CF_ACCOUNT_ID=...
CF_API_TOKEN=...
CF_TEXT_MODEL=@cf/openai/gpt-oss-120b
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# ===== Voix Kokoro (dans le conteneur) =====
KOKORO_VOICE=am_michael                        # am_michael, am_fenrir, am_puck (US) / bm_george, bm_fable (UK)
KOKORO_SPEED=1.05

LONG_SECONDS=240                               # vidéo longue horizontale (4 min)
SHORT_SECONDS=40                               # Short vertical d'accroche tiré de la même histoire
MUSIC_VOLUME=0.10                              # mp3 libres de droits dans assets/music/, 0 pour couper

# ===== Publication =====
PUBLISH_YOUTUBE=false
PUBLISH_INSTAGRAM=false
PUBLISH_TIKTOK=false
PUBLISH_FACEBOOK=false                         # Page Facebook : vidéo longue + Short en Reel
LONG_TO_SOCIAL=false                           # vidéo longue aussi sur Instagram et TikTok
WEEKLY_RECAP=true                              # récapitulatif mondial hebdomadaire (remplace la vidéo d'histoire ce jour-là)
RECAP_WEEKDAY=6                                # 0 = lundi … 6 = dimanche
RECAP_SECONDS=360
TIKTOK_MODE=inbox                              # inbox : brouillon dans ta boîte TikTok ; direct : publication directe (appli validée requise)

YOUTUBE_TOKEN_FILE=state/youtube_token.json
YOUTUBE_PRIVACY=private                        # passe à public après quelques jours de relecture

IG_USER_ID=...
IG_ACCESS_TOKEN=...
IG_GRAPH_VERSION=v23.0
IG_GRAPH_HOST=graph.facebook.com               # connexion unifiée (applis Meta récentes) ; graph.instagram.com pour l'ancienne « connexion Instagram »
PUBLIC_VIDEO_BASE_URL=https://aymendridi.com/shorts

FB_PAGE_ID=...                                 # identifiant de la Page (tools/facebook_check.py l'affiche)
FB_ACCESS_TOKEN=                               # vide = jeton Instagram (utilisateur système du portefeuille business)
FB_GRAPH_VERSION=                              # vide = même version qu'Instagram

TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_TOKEN_FILE=state/tiktok_token.json
